{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Ver aplicación de residencias",
			"type": "shell",
			"command": ".venv/bin/python",
			"args": [
				"-m",
				"streamlit",
				"run",
				"app.py",
				"--server.address=0.0.0.0"
			],
			"isBackground": true
		},
		{
			"label": "Vista alternativa de Residencias (8502)",
			"type": "shell",
			"command": ".venv/bin/python",
			"args": [
				"-m",
				"streamlit",
				"run",
				"app.py",
				"--server.address=0.0.0.0",
				"--server.port=8502",
				"--browser.gatherUsageStats=false"
			],
			"isBackground": true
		}
	]
}